{
  "name": "rekomp-data-pipeline",
  "private": true,
  "version": "0.1.0",
  "description": "Offline pipeline that builds the bundled recipe/product catalog. Not part of the app bundle.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "npm run fetch:mealdb && npm run fetch:usda",
    "fetch:mealdb": "tsx --env-file-if-exists=../../.env.local src/fetch/mealdb.ts",
    "fetch:usda": "tsx --env-file-if-exists=../../.env.local src/fetch/usda.ts",
    "build": "tsx --env-file-if-exists=../../.env.local src/build.ts",
    "validate": "tsx src/validate.ts",
    "report": "tsx src/report.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "map:draft": "tsx src/mapDraft.ts",
    "usda:find": "tsx src/usdaFind.ts",
    "images": "tsx --env-file-if-exists=../../.env.local src/images.ts",
    "photo:candidates": "tsx --env-file-if-exists=../../.env.local src/photoCandidates.ts",
    "translate": "tsx --env-file-if-exists=../../.env.local src/translate.ts",
    "translate:check": "tsx src/translateCheck.ts",
    "own:check": "tsx src/ownCheck.ts",
    "catalog": "tsx src/catalog.ts",
    "brand": "tsx src/brand.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "csv-parse": "^7.0.3",
    "parse-ingredient": "^3.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}
